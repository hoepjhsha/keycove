# ===== Application =====
APP_NAME=Keycove
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

# ===== Application Settings =====
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ===== Logging =====
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===== Docker Ports (dev only) =====
DOCKER_NGINX_PORT=8081
DOCKER_DB_PORT=3307
DOCKER_REDIS_PORT=6380
DOCKER_MINIO_PORT=9001
DOCKER_MINIO_CONSOLE_PORT=9002
DOCKER_NODE_PORT=5173

# ===== Database =====
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=keycove_db
DB_USERNAME=keycove_username
DB_PASSWORD=keycove_password
DB_ROOT_PASSWORD=root_password

# ===== Redis =====
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ===== Session =====
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ===== Cache =====
CACHE_STORE=database
#CACHE_PREFIX=keycove_

# ===== Queue & Broadcasting =====
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

# ===== Filesystem =====
FILESYSTEM_DISK=local
FILESYSTEM_PUBLIC_DISK=public
FILESYSTEM_VISIBILITY=private

# ===== MinIO / S3 Compatible Storage =====
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=keycove-private
AWS_PUBLIC_BUCKET=keycove-public
AWS_ENDPOINT=http://minio:9000
AWS_ENDPOINT_EXTERNAL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ===== Mail =====
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===== MinIO Console =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ===== Payment =====
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=
VNPAY_API_VERSION=

# ===== Frontend =====
VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=
REVERB_SCHEME=http

# ===== AI =====
AI_PROVIDER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_KEY=
AI_MODEL=gemini-flash-latest
AI_TIMEOUT=30
AI_TEMPERATURE=0.3
AI_CHAT_HISTORY_LIMIT=10
AI_DASHBOARD_CACHE_SECONDS=600
AI_REASONING_ENABLED=true
AI_HTTP_REFERER="${APP_URL}"
AI_APP_NAME="${APP_NAME}"
